FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY services/collector/pyproject.toml services/collector/pyproject.toml
COPY services/collector/src services/collector/src
RUN pip install ./services/collector
EXPOSE 8000
CMD ["uvicorn", "collector.app:app", "--host", "0.0.0.0", "--port", "8000"]
