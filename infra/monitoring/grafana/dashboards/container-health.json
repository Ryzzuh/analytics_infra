{
  "uid": "container-health",
  "title": "Container health",
  "description": "Is every container running, healthy, and staying up? Docker healthcheck state, restart loops, OOM kills and memory \u2014 the failures that look like 'Up' from the outside.",
  "tags": [
    "analytics-platform"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Exporter can see Docker",
      "id": 1,
      "description": "0 when the Docker API is unreachable \u2014 as when Docker Desktop quit and took the stack with it.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "max(container_exporter_docker_up) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO"
                },
                "1": {
                  "text": "YES"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Problems",
      "id": 2,
      "description": "Containers that are unhealthy, restart-looping, OOM-killed, never started, or exited when they should be running. One-shot init services that finished cleanly are not counted.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(container_problem == 1) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Unhealthy",
      "id": 3,
      "description": "Docker's own healthcheck failing. The Airflow scheduler died for twenty minutes inside a container still reporting Up \u2014 this is the number that would have said so.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 9,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(container_health_status == 3) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "OOM killed",
      "id": 4,
      "description": "Killed by the kernel for memory. Never retried silently: a restart policy brings it back and the next OOM kills it again.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(container_oom_killed == 1) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Running",
      "id": 5,
      "description": "Long-running containers currently up.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(container_running == 1) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "What is wrong, and where",
      "id": 6,
      "description": "One row per problem. Empty is the healthy state.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "container_problem == 1",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "env": true
            },
            "indexByName": {
              "service": 0,
              "reason": 1,
              "container": 2
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Restarts by restart policy",
      "id": 7,
      "description": "Docker's RestartCount. It resets when a container is recreated, so a rising bar means a crash loop in the current container, not history.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "sort_desc(max by (service) (container_restart_count))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "state-timeline",
      "title": "Healthcheck status over time",
      "id": 8,
      "description": "Only services that define a healthcheck \u2014 the rest have nothing for Docker to check, and are listed alongside. A band turning red is the moment Docker noticed.",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "expr": "max by (service) (container_health_status) > 0",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "options": {
        "showValue": "never",
        "rowHeight": 0.85,
        "mergeValues": true,
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e8e8e",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "healthy",
                  "index": 0
                },
                "2": {
                  "text": "starting",
                  "index": 1
                },
                "3": {
                  "text": "unhealthy",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "No healthcheck \u2014 Docker cannot tell if these are broken",
      "id": 12,
      "description": "Long-running services with no healthcheck. For these Docker knows only 'Up', which is how the Airflow scheduler sat dead for twenty minutes: nothing asked. One-shot init jobs are excluded; they are meant to exit.",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 11
      },
      "targets": [
        {
          "expr": "max by (service) (container_health_status == 0) unless on (service) max by (service) (container_completed)",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Memory by service, against what the VM has",
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "sum by (service) (container_memory_bytes)",
          "legendFormat": "{{service}}",
          "refId": "A"
        },
        {
          "expr": "max(docker_host_memory_bytes)",
          "legendFormat": "VM total",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "VM total"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "reference"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "description": "Stacked, with the VM's total as a line. The stack's whole design was bent around this: the full profile did not fit a 5 GB laptop VM."
    },
    {
      "type": "timeseries",
      "title": "CPU by service",
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "expr": "sum by (service) (container_cpu_cores)",
          "legendFormat": "{{service}}",
          "refId": "A"
        },
        {
          "expr": "max(docker_host_cpus)",
          "legendFormat": "VM cores",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "VM cores"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "reference"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "description": "Stacked, in cores, with the VM's core count as a line."
    },
    {
      "type": "bargauge",
      "title": "Uptime \u2014 shortest first",
      "id": 11,
      "description": "Recently restarted containers float to the top. A service with a few minutes of uptime on a box that has been up for days has been restarted, whether or not anyone did it on purpose.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "expr": "sort(min by (service) (container_uptime_seconds))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}
