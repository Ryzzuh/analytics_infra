# Local defaults for the core profile. Real secrets are sops-encrypted (SPEC.md §13).
SIM_ACCOUNTS=500
SIM_RATE=2
WAREHOUSE_DSN=postgresql://warehouse:warehouse@localhost:5433/warehouse
REDPANDA_BOOTSTRAP=localhost:19092
LOADER_MAX_RECORDS=50000

# Where the Console's buttons get their authority.
#
# Read-only routes are public; anything that changes state sits behind the passcode, and the
# control plane holds the Airflow credential so Caddy decides *who may ask* while the control
# plane decides *what happens* (SPEC.md §11).
#
# DOMAIN must be a hostname, not an IP. TLS SNI cannot carry an IP address, so a browser
# reaching https://<ip>/ sends no server name, Caddy cannot match a site, and the handshake
# fails with a bare "internal error". On a LAN the machine's mDNS name works.
DOMAIN=localhost

# bcrypt, from `caddy hash-password`. Unset falls back to the hash of "demo" in
# docker-compose.yml — fine locally, never for anything reachable.
# DEMO_PASSCODE_HASH=

# The Console's "Run pipeline" button authenticates as this Airflow user. Set it to anything
# before exposing the stack; the compose default is a published placeholder.
#
# Airflow 3 issues JWTs that expire after 24 hours, so this is deliberately a *password* and not
# a token: an AIRFLOW_API_TOKEN pasted in here was dead within a day and failed as a 502 wrapping
# Airflow's own "Token Expired", in front of whoever was being shown the demo. The control plane
# now exchanges these credentials for a token itself and re-mints whenever Airflow rejects one.
#
# airflow-init seeds this into the password file SimpleAuthManager reads, on a volume shared with
# the api-server, so it survives container recreates — which is what used to invalidate it. The
# file is only written when absent: to rotate, change this and delete the volume.
AIRFLOW_ADMIN_PASSWORD=
