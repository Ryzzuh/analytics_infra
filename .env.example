# Local defaults for the core profile. Real secrets are sops-encrypted (SPEC.md §13).
SIM_ACCOUNTS=500
SIM_RATE=2
WAREHOUSE_DSN=postgresql://warehouse:warehouse@localhost:5433/warehouse
REDPANDA_BOOTSTRAP=localhost:19092
LOADER_MAX_RECORDS=50000

# Where the Console's buttons get their authority.
#
# Read-only routes are public; anything that changes state sits behind the passcode, and the
# control plane holds the Airflow credential so Caddy decides *who may ask* while the control
# plane decides *what happens* (SPEC.md §11).
#
# DOMAIN must be a hostname, not an IP. TLS SNI cannot carry an IP address, so a browser
# reaching https://<ip>/ sends no server name, Caddy cannot match a site, and the handshake
# fails with a bare "internal error". On a LAN the machine's mDNS name works.
DOMAIN=localhost

# bcrypt, from `caddy hash-password`. Unset falls back to the hash of "demo" in
# docker-compose.yml — fine locally, never for anything reachable.
# DEMO_PASSCODE_HASH=

# Without this the Console's "Run pipeline" button returns 503 "control plane has no Airflow
# token". Airflow 3 issues JWTs from /auth/token; the api-server prints the generated admin
# password on startup and writes it to $AIRFLOW_HOME/simple_auth_manager_passwords.json.generated
# (note the suffix). Mint one with:
#
#   PW=$(docker compose exec airflow-apiserver sh -c \
#     'cat $AIRFLOW_HOME/simple_auth_manager_passwords.json.generated' \
#     | python3 -c 'import json,sys; print(json.load(sys.stdin)["admin"])')
#   docker compose exec airflow-apiserver curl -s -X POST localhost:8080/auth/token \
#     -H 'Content-Type: application/json' -d "{\"username\":\"admin\",\"password\":\"$PW\"}"
#
# The token expires and the password is regenerated whenever the api-server container is
# recreated, so treat this as a demo convenience rather than a credential to rely on.
AIRFLOW_API_TOKEN=
